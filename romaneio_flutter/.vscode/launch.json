{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Android Debug",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "flutterMode": "debug"
    },
    {
      "name": "Flutter: Web Debug",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "args": [
        "-d",
        "chrome"
      ],
      "cwd": "${workspaceFolder}",
      "flutterMode": "debug"
    }
  ]
}
